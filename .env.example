
# Analytics (optional). Leave empty to load nothing.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Canonical domain. Defaults to https://teamy.in. Set to the vercel.app URL until teamy.in points at Vercel.
NEXT_PUBLIC_SITE_URL=
# Set to "true" once teamy.in is connected to Vercel: 301-redirects teamy-blush.vercel.app → teamy.in
# and adds noindex on any other *.vercel.app host.
PRIMARY_DOMAIN_LIVE=

# Search Console / Bing Webmaster verification codes (content="…" of their meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
