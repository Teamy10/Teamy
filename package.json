{
  "name": "myown-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "capture:work": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-work.mjs",
    "capture:logos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-logos.mjs",
    "capture:videos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-videos.mjs",
    "capture:all": "npm run capture:work && npm run capture:logos && npm run capture:videos"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "next": "^16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
